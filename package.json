{
  "name": "restobox",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env ./node_modules/astro/bin/astro.mjs dev",
    "start": "node --env-file-if-exists=.env ./dist/server/entry.mjs",
    "build": "astro build",
    "backup": "node scripts/backup.mjs",
    "cleanup:media": "node scripts/cleanup-media.mjs",
    "package:extension": "powershell -ExecutionPolicy Bypass -File scripts/package-extension.ps1",
    "check": "astro check",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.0",
    "astro": "^7.2.0",
    "cheerio": "^1.2.0",
    "google-auth-library": "^11.0.2",
    "leaflet": "^1.9.4",
    "read-excel-file": "^9.3.10",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.2.0",
    "typescript": "^6.0.3"
  }
}
