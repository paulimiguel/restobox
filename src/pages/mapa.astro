---
import '../styles/global.css';
import { listRestaurants } from '../lib/server/database';

type MapRestaurant = {
	id: string;
	name: string;
	address: string;
	neighborhood: string;
	city: string;
	province: string;
	country: string;
	mapUrl: string;
};

const text = (value: unknown) => typeof value === 'string' ? value.trim() : '';
const restaurants: MapRestaurant[] = listRestaurants().map((restaurant) => ({
	id: restaurant.id,
	name: restaurant.name,
	address: text(restaurant.address),
	neighborhood: text(restaurant.neighborhood),
	city: text(restaurant.city),
	province: text(restaurant.province),
	country: text(restaurant.country),
	mapUrl: text(restaurant.mapUrl),
}));
const serializedRestaurants = JSON.stringify(restaurants).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content="Mapa de los restaurantes guardados en RestoBox." />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
		<title>Mapa de restaurantes · RestoBox</title>
		<script is:inline>
			try {
				const colorMode = localStorage.getItem('restobox-color-mode') === 'dark' ? 'dark' : 'light';
				document.documentElement.dataset.colorMode = colorMode;
				document.documentElement.dataset.theme = localStorage.getItem('theme') || 'carrot';
				document.documentElement.dataset.fontTheme = localStorage.getItem('font-theme') || 'original';
				document.documentElement.style.colorScheme = colorMode;
			} catch {
				document.documentElement.dataset.colorMode = 'light';
			}
		</script>
		<style is:global>
			.map-page { min-height: 100vh; display: grid; grid-template-rows: auto 1fr; background: var(--cream); }
			.map-header { min-height: 88px; display: flex; align-items: center; gap: 24px; padding: 7px max(4vw, calc((100% - 1520px) / 2)); border-bottom: 1px solid var(--line); background: var(--paper); box-shadow: 0 3px 14px rgba(30,42,35,.04); }
			.map-header .header-brand { margin-right: 0; }
			.map-heading { min-width: 0; }
			.map-heading h1 { margin: 0; color: var(--ink); font-size: clamp(20px, 2.4vw, 30px); font-family: var(--font-display); font-weight: 600; }
			.map-heading p { margin: 4px 0 0; color: var(--muted); font-size: 13px; }
			.map-back { display: inline-flex; min-height: 40px; align-items: center; gap: 8px; margin-left: auto; padding: 8px 13px; border: 1px solid var(--line); border-radius: 8px; color: var(--ink); background: var(--paper); text-decoration: none; font-size: 12px; font-weight: 700; white-space: nowrap; }
			.map-back:hover { color: var(--accent-text); background: var(--sage); }
			.map-back svg { width: 17px; }
			.map-content { position: relative; min-height: calc(100vh - 88px); padding: 18px max(4vw, calc((100% - 1520px) / 2)) 24px; }
			.map-canvas { width: 100%; height: calc(100vh - 130px); min-height: 520px; overflow: hidden; border: 1px solid var(--line); border-radius: 14px; background: var(--sage); box-shadow: 0 12px 32px rgba(30,42,35,.1); }
			.map-status { position: absolute; z-index: 2; top: 32px; left: calc(max(4vw, (100% - 1520px) / 2) + 14px); max-width: min(390px, calc(100% - 56px)); margin: 0; padding: 10px 13px; border: 1px solid var(--line); border-radius: 8px; color: var(--ink); background: color-mix(in srgb, var(--paper) 94%, transparent); box-shadow: 0 5px 18px rgba(30,42,35,.13); font-size: 12px; font-weight: 600; line-height: 1.4; }
			.map-status[hidden] { display: none; }
			.map-error { display: grid; height: 100%; place-items: center; padding: 32px; color: var(--muted); text-align: center; }
			.map-pin { color: var(--forest); background: transparent; border: 0; filter: drop-shadow(0 3px 4px rgba(0,0,0,.35)); }
			.map-pin svg { display: block; }
			.map-info { color: #28312d; font-family: Arial, sans-serif; line-height: 1.35; }
			.map-info strong { display: block; margin-bottom: 4px; font-size: 14px; }
			.map-info span { display: block; max-width: 260px; font-size: 12px; }
			.map-info a { display: inline-block; margin-top: 7px; color: #1769aa; font-size: 12px; font-weight: 700; }
			@media (max-width: 640px) {
				.map-header { min-height: 76px; gap: 12px; padding: 5px 16px; }
				.map-header .header-brand { width: 88px; height: 62px; flex-basis: 88px; }
				.map-header .header-brand img { width: 84px; height: 58px; }
				.map-heading p { display: none; }
				.map-back span { display: none; }
				.map-back { width: 40px; padding: 0; justify-content: center; }
				.map-content { min-height: calc(100vh - 76px); padding: 10px; }
				.map-canvas { height: calc(100vh - 96px); min-height: 440px; border-radius: 10px; }
				.map-status { top: 22px; left: 22px; max-width: calc(100% - 44px); }
			}
		</style>
	</head>
	<body>
		<div class="map-page">
			<header class="map-header">
				<a class="header-brand" href="/" aria-label="RestoBox, inicio"><img src="/restobox-logo-transparent.png" alt="RestoBox" /></a>
				<div class="map-heading">
					<h1>Mapa de restaurantes</h1>
					<p>Todos los lugares cargados en RestoBox</p>
				</div>
				<a class="map-back" href="/"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg><span>Volver al directorio</span></a>
			</header>
			<main class="map-content">
				<p id="map-status" class="map-status" role="status">Preparando el mapa…</p>
				<div id="restaurant-map" class="map-canvas" aria-label="Mapa con los restaurantes cargados"></div>
			</main>
		</div>
		<script is:inline id="map-restaurants-data" type="application/json" set:html={serializedRestaurants}></script>
		<script src="../scripts/mapa.ts"></script>
	</body>
</html>
