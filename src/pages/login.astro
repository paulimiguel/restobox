---
import { countUsers } from '../lib/server/auth';
import { isGoogleAuthConfigured, safeLoginDestination } from '../lib/server/google-auth';
const passwordConfigured = countUsers() > 0;
const googleConfigured = isGoogleAuthConfigured();
const next = safeLoginDestination(Astro.url.searchParams.get('next'));
const googleLoginUrl = `/api/auth/google/start?next=${encodeURIComponent(next)}`;
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
		<title>Ingresar | RestoBox</title>
		<style>
			:root { font-family: Inter, system-ui, sans-serif; color: #26382f; background: #f7f6f2; }
			body { display: grid; min-height: 100vh; margin: 0; place-items: center; }
			main { width: min(390px, calc(100% - 32px)); padding: 34px; border: 1px solid #d8e7e2; border-radius: 14px; background: white; box-shadow: 0 20px 55px rgba(25,45,36,.12); }
			img { display: block; width: 180px; height: 76px; margin: 0 auto 20px; object-fit: contain; }
			h1 { margin: 0 0 8px; font-size: 25px; text-align: center; }
			p { margin: 0 0 22px; color: #6b746f; font-size: 14px; line-height: 1.5; text-align: center; }
			form, label { display: grid; gap: 8px; }
			form { gap: 16px; }
			label { color: #4e5953; font-size: 13px; font-weight: 650; }
			input { height: 44px; padding: 0 13px; border: 1px solid #c9ddd6; border-radius: 8px; font: inherit; }
			input:focus { border-color: #318b7b; outline: 3px solid rgba(49,139,123,.12); }
			button { height: 45px; border: 0; border-radius: 8px; color: #173a32; background: #bde9df; font: inherit; font-weight: 750; cursor: pointer; }
			button:hover { background: #96ddce; }
			button:disabled { cursor: wait; opacity: .65; }
			.login-divider { display: flex; align-items: center; gap: 12px; margin: 18px 0; color: #84908a; font-size: 12px; }
			.login-divider::before, .login-divider::after { content: ''; height: 1px; flex: 1; background: #dce7e3; }
			.google-login { display: flex; height: 45px; align-items: center; justify-content: center; gap: 10px; border: 1px solid #cbd8d3; border-radius: 8px; color: #37433d; background: white; font-size: 14px; font-weight: 700; text-decoration: none; transition: border-color .18s, background .18s, box-shadow .18s; }
			.google-login:hover { border-color: #9dbab0; background: #f8fbfa; box-shadow: 0 4px 12px rgba(25,45,36,.08); }
			.google-login svg { width: 19px; height: 19px; flex: 0 0 auto; }
			.google-login[aria-disabled='true'] { pointer-events: none; opacity: .48; }
			.google-setup { margin: 9px 0 0; color: #7a837e; font-size: 11px; }
			#error { min-height: 20px; margin: 0; color: #b42318; font-size: 13px; }
			.setup { padding: 12px; border-radius: 8px; background: #fff3cd; color: #6b5412; }
		</style>
	</head>
	<body>
		<main>
			<img src="/restobox-logo-transparent.png" alt="RestoBox" />
			<h1>Ingresar</h1>
			{passwordConfigured || googleConfigured ? <p>Accedé a tu base de lugares.</p> : <p class="setup">Configurá un método de ingreso en el servidor para continuar.</p>}
			<p id="error" role="alert"></p>
			<form id="login-form" hidden={!passwordConfigured}>
				<label>Usuario <input name="username" autocomplete="username" required /></label>
				<label>Contraseña <input name="password" type="password" autocomplete="current-password" required /></label>
				<button type="submit">Ingresar</button>
			</form>
			{passwordConfigured && <div class="login-divider">o</div>}
			<a class="google-login" href={googleConfigured ? googleLoginUrl : undefined} aria-disabled={googleConfigured ? undefined : 'true'} title={googleConfigured ? 'Ingresar con una cuenta de Google autorizada' : 'Falta configurar Google en el servidor'}>
				<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M21.6 12.2c0-.7-.1-1.5-.2-2.2H12v4h5.4a4.6 4.6 0 0 1-2 3v2.6h3.3c1.9-1.8 2.9-4.4 2.9-7.4Z"/><path fill="#34A853" d="M12 22c2.7 0 5-.9 6.7-2.4L15.4 17c-.9.6-2.1 1-3.4 1a5.9 5.9 0 0 1-5.5-4.1H3.1v2.7A10 10 0 0 0 12 22Z"/><path fill="#FBBC05" d="M6.5 13.9A6 6 0 0 1 6.2 12c0-.7.1-1.3.3-1.9V7.4H3.1A10 10 0 0 0 2 12c0 1.7.4 3.2 1.1 4.6l3.4-2.7Z"/><path fill="#EA4335" d="M12 6c1.5 0 2.8.5 3.9 1.5l2.9-2.9A9.7 9.7 0 0 0 12 2a10 10 0 0 0-8.9 5.4l3.4 2.7A5.9 5.9 0 0 1 12 6Z"/></svg>
				<span>Entrar con Google</span>
			</a>
			{!googleConfigured && <p class="google-setup">El acceso con Google estará disponible al completar su configuración.</p>}
		</main>
		<script>
			const form = document.querySelector<HTMLFormElement>('#login-form');
			const googleErrors: Record<string, string> = {
				not_configured: 'El acceso con Google todavía no está configurado.',
				cancelled: 'El ingreso con Google fue cancelado.',
				invalid_state: 'La solicitud de Google venció o no es válida. Intentá nuevamente.',
				not_allowed: 'Esa cuenta de Google no está autorizada para ingresar.',
				failed: 'No se pudo completar el ingreso con Google.',
			};
			const googleError = new URLSearchParams(location.search).get('google_error');
			if (googleError) document.querySelector<HTMLElement>('#error')!.textContent = googleErrors[googleError] ?? googleErrors.failed;
			form?.addEventListener('submit', async (event) => {
				event.preventDefault();
				const button = form.querySelector<HTMLButtonElement>('button')!;
				const error = document.querySelector<HTMLElement>('#error')!;
				button.disabled = true;
				error.textContent = '';
				try {
					const data = Object.fromEntries(new FormData(form));
					const response = await fetch('/api/auth/login', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(data) });
					const result = await response.json();
					if (!response.ok) throw new Error(result.error || 'No se pudo ingresar');
					const next = new URLSearchParams(location.search).get('next');
					location.href = next?.startsWith('/') && !next.startsWith('//') ? next : '/';
				} catch (cause) { error.textContent = cause instanceof Error ? cause.message : 'No se pudo ingresar'; }
				finally { button.disabled = false; }
			});
		</script>
	</body>
</html>
