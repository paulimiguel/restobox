			</form>
		</dialog>

		<dialog id="name-import-dialog" class="mini-dialog name-import-dialog">
			<form id="name-import-form">
				<h2>Importar lugar por nombre</h2>
				<label for="place-search-name">Nombre del lugar</label>
				<input id="place-search-name" type="text" maxlength="120" autocomplete="off" placeholder="Ej. Piazza Normandina, Mar del Plata" required />
				<p class="url-import-help">Podés agregar la ciudad o el barrio para obtener un resultado más preciso.</p>
				<div id="name-import-progress" class="url-import-progress" role="status" aria-live="polite" hidden></div>
				<div class="mini-dialog-actions">
					<button id="cancel-name-import" class="secondary-button" type="button">Cancelar</button>
					<button id="search-name-import" class="primary-button" type="submit">Buscar e importar</button>
				</div>
			</form>
		</dialog>

		<dialog id="excel-import-dialog" class="mini-dialog excel-import-dialog">
			<form id="excel-import-form">
				<h2>Importar desde Excel</h2>
				<p class="url-import-help">Seleccioná una planilla de Excel o CSV. La primera fila debe contener los nombres de las columnas y <strong>Nombre</strong> es la única columna obligatoria.</p>
				<label for="excel-import-file">Planilla</label>
				<input id="excel-import-file" type="file" accept=".xlsx,.csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/csv" required />
				<p class="excel-import-columns">Columnas reconocidas: Nombre, Descripción, Lugar, Cocina, Servicios, Etiquetas, Delivery, Take away, Sin gluten, Calificación, Puntaje, Nivel de precio, Precio promedio, País, Provincia, Ciudad, Dirección, Barrio, Teléfono, Celular, Sitio web, Google, Linktree, Menú, Instagram, TikTok, Facebook, Woki, TripAdvisor, Mapa, Horarios, Notas, Favorito y Visitado.</p>
				<div id="excel-import-progress" class="url-import-progress" role="status" aria-live="polite" hidden></div>
				<div id="excel-import-preview" class="excel-import-preview" hidden>
					<strong id="excel-import-summary"></strong>
					<div class="excel-preview-table-wrap">
						<table>
							<thead><tr><th>Fila</th><th>Nombre</th><th>Lugar</th><th>Ciudad</th><th>Estado</th></tr></thead>
							<tbody id="excel-import-preview-body"></tbody>
						</table>
					</div>
				</div>
				<div class="mini-dialog-actions">
					<button id="cancel-excel-import" class="secondary-button" type="button">Cancelar</button>
					<button id="import-excel-button" class="primary-button" type="submit" disabled>Importar lugares</button>
				</div>
			</form>
		</dialog>

		<dialog id="delete-place-dialog" class="mini-dialog delete-place-dialog">
			<form method="dialog">
				<h2>Eliminar lugar</h2>
				<p id="delete-place-message"></p>
				<div class="mini-dialog-actions">
					<button class="secondary-button" type="submit" value="cancel">Cancelar</button>
					<button class="primary-button" type="submit" value="confirm">Aceptar</button>
				</div>
			</form>
		</dialog>

		<dialog id="bulk-edit-dialog" class="mini-dialog bulk-edit-dialog">
			<form id="bulk-edit-form">
				<h2>Editar campos comunes</h2>
				<p id="bulk-edit-count" class="bulk-edit-help"></p>
				<div class="bulk-edit-grid">
					<label><span>Barrio</span><input name="neighborhood" list="bulk-neighborhoods" placeholder="Sin cambios" /></label>
					<label><span>Ciudad</span><input name="city" list="bulk-cities" placeholder="Sin cambios" /></label>
					<label><span>Provincia</span><input name="province" list="bulk-provinces" placeholder="Sin cambios" /></label>
					<label><span>País</span><input name="country" list="bulk-countries" placeholder="Sin cambios" /></label>
					<div class="bulk-choice-field"><span>Tipo de lugar</span><div id="bulk-establishment-options" class="bulk-choice-list"></div></div>
					<div class="bulk-choice-field"><span>Servicio</span><div id="bulk-service-options" class="bulk-choice-list"></div></div>
					<div class="bulk-choice-field bulk-choice-wide"><span>Tipo de cocina</span><div id="bulk-cuisine-options" class="bulk-choice-list"></div></div>
					<div class="bulk-choice-field bulk-choice-wide"><span>Etiquetas</span>
						<details class="bulk-choice-dropdown">
							<summary><span id="bulk-tags-label">Seleccionar etiquetas</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 10 4 4 4-4"/></svg></summary>
							<div id="bulk-tag-options" class="bulk-choice-list"></div>
						</details>
					</div>
					<label><span>Nivel de precio</span><select name="price"><option value="">Sin cambios</option><option>$</option><option>$$</option><option>$$$</option><option>$$$$</option></select></label>
					<label><span>Precio promedio por persona</span><input name="averagePrice" list="average-price-options" placeholder="Sin cambios" /></label>
					<div class="bulk-status-fields">
						<label><span>Calificación</span><select name="rating"><option value="">Sin cambios</option><option value="1">1 estrella</option><option value="2">2 estrellas</option><option value="3">3 estrellas</option><option value="4">4 estrellas</option><option value="5">5 estrellas</option></select></label>
						<label><span>Favorito</span><select name="favorite"><option value="">Sin cambios</option><option value="true">Sí</option><option value="false">No</option></select></label>
						<label><span>Visitado</span><select name="visited"><option value="">Sin cambios</option><option value="true">Sí</option><option value="false">No</option></select></label>
						<label><span>Checked</span><select name="checked"><option value="">Sin cambios</option><option value="true">Sí</option><option value="false">No</option></select></label>
						<label><span>Delivery</span><select name="delivery"><option value="">Sin cambios</option><option value="true">Sí</option><option value="false">No</option></select></label>
						<label><span>Take away</span><select name="takeAway"><option value="">Sin cambios</option><option value="true">Sí</option><option value="false">No</option></select></label>
						<label><span>Sin gluten</span><select name="glutenFree"><option value="">Sin cambios</option><option value="true">Sí</option><option value="false">No</option></select></label>
					</div>
				</div>
				<datalist id="bulk-neighborhoods"></datalist><datalist id="bulk-cities"></datalist><datalist id="bulk-provinces"></datalist><datalist id="bulk-countries"></datalist>
				<div class="mini-dialog-actions">
					<button id="cancel-bulk-edit" class="secondary-button" type="button">Cancelar</button>
					<button class="primary-button" type="submit" data-bulk-save-mode="update">Aplicar cambios</button>
					<button class="primary-button" type="submit" data-bulk-save-mode="finish">Finalizar edición</button>
				</div>
			</form>
		</dialog>

		<dialog id="image-carousel-dialog" class="image-carousel-dialog" aria-label="Galería de imágenes">
			<div class="image-carousel-heading">
				<span id="image-carousel-counter"></span>
				<button id="close-image-carousel" type="button" aria-label="Cerrar galería" title="Cerrar">×</button>
			</div>
			<div class="image-carousel-stage">
				<button id="previous-carousel-image" class="image-carousel-arrow previous" type="button" aria-label="Imagen anterior" title="Imagen anterior">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
				</button>
				<img id="image-carousel-image" alt="" />
				<button id="next-carousel-image" class="image-carousel-arrow next" type="button" aria-label="Imagen siguiente" title="Imagen siguiente">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
				</button>
			</div>
		</dialog>

		<dialog id="profile-dialog" class="mini-dialog profile-dialog">
			<form id="profile-form">
				<div class="profile-dialog-heading">
					<h2>Editar perfil</h2>
					<button id="close-profile-dialog" class="profile-close-button" type="button" aria-label="Cerrar">×</button>
				</div>
				<div id="profile-message" class="profile-message" role="status" hidden></div>
				<div class="profile-photo-section">
					<span class="profile-field-title">Foto de perfil</span>
					<div class="profile-photo-preview" id="profile-photo-preview">
						{currentUser?.profilePhoto ? <img src={currentUser.profilePhoto} alt="Foto de perfil" /> : <span>{userInitials}</span>}
					</div>
					<div class="profile-photo-actions">
						<label class="secondary-button profile-upload-button" for="profile-photo-input"><svg viewBox="0 0 24 24"><path d="M12 16V4m0 0-4 4m4-4 4 4M5 15v5h14v-5"/></svg>Subir foto</label>
						<button id="remove-profile-photo" class="text-button" type="button" hidden>Quitar foto</button>
					</div>
					<input id="profile-photo-input" type="file" accept="image/jpeg,image/png,image/webp" hidden />
				</div>
				<label><span>Email</span><div class="profile-input-wrap"><svg viewBox="0 0 24 24"><path d="M3 5h18v14H3zM3 6l9 7 9-7"/></svg><input id="profile-email" type="email" maxlength="254" value={userDisplayEmail} autocomplete="email" /></div></label>
				<label><span>Nombre</span><div class="profile-input-wrap"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3"/><path d="M5 20a7 7 0 0 1 14 0"/></svg><input id="profile-name" type="text" maxlength="100" value={currentUser?.name || currentUser?.username || ''} required autocomplete="name" /></div></label>
				<label><span>Alias (opcional)</span><div class="profile-input-wrap"><svg viewBox="0 0 24 24"><path d="M3 12V4h8l10 10-7 7L3 12z"/><circle cx="8" cy="8" r="1"/></svg><input id="profile-alias" type="text" maxlength="80" value={currentUser?.alias || ''} placeholder="Cómo querés que aparezca tu nombre" /></div></label>
				{!isGoogleUser && <details class="password-editor">
					<summary><svg viewBox="0 0 24 24"><circle cx="8" cy="15" r="4"/><path d="m11 12 8-8m-3 3 2 2m-5 1 2 2"/></svg>Cambiar contraseña</summary>
					<div class="password-editor-fields">
						<label><span>Contraseña actual</span><input id="profile-current-password" type="password" autocomplete="current-password" /></label>
						<label><span>Nueva contraseña</span><input id="profile-new-password" type="password" minlength="12" autocomplete="new-password" /></label>
					</div>
				</details>}
				<div class="mini-dialog-actions">
					<button id="cancel-profile" class="secondary-button" type="button">Cancelar</button>
					<button id="save-profile" class="primary-button" type="submit">Guardar cambios</button>
				</div>
			</form>
		</dialog>

		<dialog id="extension-dialog" class="mini-dialog extension-dialog">
			<div class="extension-dialog-content">
				<div class="profile-dialog-heading">
					<h2>Extensión Chrome de RestoBox</h2>
					<button id="close-extension-dialog" class="profile-close-button" type="button" aria-label="Cerrar">×</button>
				</div>
				<p class="extension-intro">Importá el lugar de la página que estás visitando directamente en RestoBox.</p>
				<ol class="extension-steps">
					<li><span>1</span><div><strong>Descargá la extensión</strong><small>Guardá y descomprimí el archivo ZIP.</small></div></li>
					<li><span>2</span><div><strong>Abrí las extensiones de Chrome</strong><small>Ingresá <code>chrome://extensions/</code> en la barra del navegador.</small></div></li>
					<li><span>3</span><div><strong>Activá el modo desarrollador</strong><small>Usá el interruptor que aparece arriba a la derecha.</small></div></li>
					<li><span>4</span><div><strong>Cargá la carpeta</strong><small>Elegí “Cargar extensión sin empaquetar” y seleccioná la carpeta descomprimida.</small></div></li>
				</ol>
				<div class="mini-dialog-actions">
					<button id="cancel-extension" class="secondary-button" type="button">Cerrar</button>
					<a class="primary-button" href="/downloads/restobox-extension.zip" download>Descargar extensión</a>
				</div>
			</div>
		</dialog>

		<div id="toast" class="toast" role="status" aria-live="polite"></div>
		<script src="../scripts/restaurants.ts"></script>
		<script src="../scripts/profile.ts"></script>
	</body>
</html>
