---
import '../styles/global.css';
import { getUserProfile } from '../lib/server/auth';
const sessionUser = await Astro.session?.get('user');
const currentUser = sessionUser ? (getUserProfile(sessionUser.id) ?? sessionUser) : undefined;
const userDisplayName = currentUser?.alias || currentUser?.name || currentUser?.username || 'Usuario';
const userDisplayEmail = currentUser?.email || (currentUser?.username.includes('@') ? currentUser.username : '');
const isGoogleUser = currentUser?.authProvider === 'google' || currentUser?.id.startsWith('google:');
const userInitials = userDisplayName
	.split(/[\s._-]+/)
	.filter(Boolean)
	.slice(0, 2)
	.map((part) => part[0]?.toLocaleUpperCase('es'))
	.join('') || 'RB';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content="Directorio privado para centralizar la información de tus restaurantes." />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
		<title>RestoBox · Directorio de restaurantes</title>
	</head>
	<body>
		<div class="app-shell">
			<main>
				<header class="topbar">
					<a class="header-brand" href="/" aria-label="RestoBox, inicio"><img id="header-theme-logo" src="/restobox-logo-transparent.png" alt="RestoBox" /></a>
					<nav class="top-actions" aria-label="Menú principal">
						<details class="top-dropdown theme-dropdown">
							<summary class="top-icon-button" aria-label="Elegir tema" title="Elegir tema">
								<svg viewBox="0 0 24 24"><path d="M12 3a9 9 0 1 0 0 18h1.5a1.8 1.8 0 0 0 0-3.6h-1a1.5 1.5 0 0 1 0-3H15A6 6 0 0 0 15 3Z"/><circle cx="7.5" cy="10" r=".8"/><circle cx="10" cy="6.8" r=".8"/></svg>
							</summary>
							<div class="dropdown-panel theme-panel">
								<button type="button" data-theme-value="aguamarina"><span style="--swatch:#A5D8E8"></span>Aguamarina</button>
								<button type="button" data-theme-value="carrot"><span style="--swatch:#FC7813"></span>Carrot</button>
								<button type="button" data-theme-value="frutilla"><span style="--swatch:#F90344"></span>Frutilla</button>
								<button type="button" data-theme-value="grises"><span style="--swatch:#B4B7BC"></span>Grises</button>
								<button type="button" data-theme-value="pasteles"><span style="--swatch:#F7B9C3"></span>Pasteles</button>
								<button type="button" data-theme-value="salmon"><span style="--swatch:#E26666"></span>Salmón</button>
								<button type="button" data-theme-value="tierra"><span style="--swatch:#E1C097"></span>Tierra</button>
								<button type="button" data-theme-value="violetas"><span style="--swatch:#A089BF"></span>Violetas</button>
							</div>
						</details>
						<details class="top-dropdown font-theme-dropdown">
							<summary class="top-icon-button" aria-label="Elegir tema de fuentes" title="Elegir tema de fuentes">
								<span class="font-theme-icon" aria-hidden="true">Aa</span>
							</summary>
							<div class="dropdown-panel font-theme-panel">
								<button type="button" data-font-theme-value="original"><span class="font-preview font-preview-original">Aa</span><span>Original</span></button>
								<button type="button" data-font-theme-value="moderna"><span class="font-preview font-preview-moderna">Aa</span><span>Moderna</span></button>
								<button type="button" data-font-theme-value="elegante"><span class="font-preview font-preview-elegante">Aa</span><span>Elegante</span></button>
								<button type="button" data-font-theme-value="amable"><span class="font-preview font-preview-amable">Aa</span><span>Amable</span></button>
								<button type="button" data-font-theme-value="clasica"><span class="font-preview font-preview-clasica">Aa</span><span>Clásica</span></button>
							</div>
						</details>

						<button class="top-nav-button" id="main-search-button" type="button">
							<svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="6"/><path d="m16 16 4 4"/></svg>
							<span>BUSCAR</span>
						</button>

						<button class="top-nav-button header-nav-link" id="header-directory" type="button">DIRECTORIO</button>
						<details class="top-dropdown category-dropdown">
							<summary class="top-nav-button"><span>LUGAR</span><svg class="chevron" viewBox="0 0 24 24"><path d="m8 10 4 4 4-4"/></svg></summary>
							<div id="header-establishment-options" class="dropdown-panel category-panel"></div>
						</details>
						<details class="top-dropdown category-dropdown">
							<summary class="top-nav-button"><span>SERVICIO</span><svg class="chevron" viewBox="0 0 24 24"><path d="m8 10 4 4 4-4"/></svg></summary>
							<div id="header-service-options" class="dropdown-panel category-panel"></div>
						</details>
						<details class="top-dropdown category-dropdown">
							<summary class="top-nav-button"><span>COCINA</span><svg class="chevron" viewBox="0 0 24 24"><path d="m8 10 4 4 4-4"/></svg></summary>
							<div id="header-cuisine-options" class="dropdown-panel category-panel"></div>
						</details>

						<details class="top-dropdown actions-dropdown">
							<summary class="top-nav-button"><span>ACCIONES</span><svg class="chevron" viewBox="0 0 24 24"><path d="m8 10 4 4 4-4"/></svg></summary>
							<div class="dropdown-panel actions-panel">
								<button type="button" data-open-form><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 8v8M8 12h8"/></svg>Nuevo lugar</button>
								<button type="button" id="header-import-place"><svg viewBox="0 0 24 24"><path d="M12 3v12m0 0-4-4m4 4 4-4M5 17v3h14v-3"/></svg>Importar lugar</button>
								<button type="button" data-open-excel-import><svg viewBox="0 0 24 24"><path d="M4 4h16v16H4zM4 10h16M10 4v16"/></svg>Importar Excel</button>
								<button type="button" id="header-edit-places"><svg viewBox="0 0 24 24"><path d="m14 5 5 5M4 20l4.5-1 10-10a2.1 2.1 0 0 0-3-3l-10 10z"/></svg>Editar</button>
								<button type="button" id="header-delete-places"><svg viewBox="0 0 24 24"><path d="M4 7h16M9 7V4h6v3m3 0-1 13H7L6 7m4 4v5m4-5v5"/></svg>Eliminar</button>
								<button type="button" id="header-print-directory"><svg viewBox="0 0 24 24"><path d="M7 9V4h10v5M7 17H5a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-2M7 14h10v7H7z"/></svg>Imprimir</button>
							</div>
						</details>

						<details class="top-dropdown add-dropdown">
							<summary class="top-nav-button" aria-label="Agregar" title="Agregar">
								<svg class="plus-circle" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 8v8M8 12h8"/></svg>
								<svg class="chevron" viewBox="0 0 24 24"><path d="m8 10 4 4 4-4"/></svg>
							</summary>
							<div class="dropdown-panel add-panel">
								<button type="button" data-open-form><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 8v8M8 12h8"/></svg>Nuevo lugar</button>
								<button type="button" id="open-url-import"><svg viewBox="0 0 24 24"><path d="M12 3v12m0 0-4-4m4 4 4-4M5 17v3h14v-3"/></svg>Importar lugar</button>
								<button type="button" data-open-excel-import><svg viewBox="0 0 24 24"><path d="M4 4h16v16H4zM4 10h16M10 4v16"/></svg>Importar Excel</button>
							</div>
						</details>

						<details class="top-dropdown user-dropdown">
							<summary class="avatar" aria-label="Menú de usuario" title="Usuario">
								{currentUser?.profilePhoto ? <img id="header-profile-photo" src={currentUser.profilePhoto} alt="" /> : <span id="header-profile-initials">{userInitials}</span>}
							</summary>
							<div class="dropdown-panel user-panel">
								<div class="user-summary"><strong id="user-menu-name">{userDisplayName}</strong><small id="user-menu-email">{userDisplayEmail}</small></div>
								<div class="dropdown-separator"></div>
								<button type="button" id="open-profile-dialog"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3"/><path d="M5 20a7 7 0 0 1 14 0M4 4h3M5.5 2.5v3"/></svg>Editar perfil</button>
								<button type="button" id="open-extension-dialog"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><path d="M4.8 8h14.4M8 4.8l4 7.2m4-7.2L12 12m0 0v8"/></svg>Instalar Extensión Chrome</button>
								<div class="dropdown-separator"></div>
								<button type="button" id="logout-button"><svg viewBox="0 0 24 24"><path d="M10 4H5v16h5M14 8l4 4-4 4M8 12h10"/></svg>Cerrar sesión</button>
							</div>
						</details>
					</nav>
				</header>

				<div class="content">
					<section class="directory-actions" id="directorio" aria-label="Herramientas del directorio">
						<div class="directory-actions-left">
							<div class="action-search-group">
								<label class="action-search">
									<span class="sr-only">Buscar restaurantes</span>
									<svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="6"/><path d="m16 16 4 4"/></svg>
									<input id="search" type="search" placeholder="Buscar" title="Escribí una palabra o frase y pulsá Enter para agregarla. Podés sumar varias." autocomplete="off" />
								</label>
								<div class="search-scope-options" role="radiogroup" aria-label="Campo de búsqueda">
									<label title="Busca cada palabra en todos los datos del lugar"><input type="radio" name="searchScope" value="keyword" checked />Palabra clave</label>
									<label title="Busca cada frase solamente en el nombre del lugar"><input type="radio" name="searchScope" value="name" />Nombre</label>
								</div>
								<div id="search-terms-row" class="search-terms-row" hidden>
									<div id="search-terms" class="search-terms-list" aria-label="Términos de búsqueda"></div>
									<button id="clear-search-terms" type="button">LIMPIAR</button>
								</div>
							</div>
							<details class="directory-action-menu new-establishment-menu">
								<summary><span><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><path d="M12 8v8M8 12h8"/></svg>Importar lugar</span><svg class="action-chevron" viewBox="0 0 24 24"><path d="m8 10 4 4 4-4"/></svg></summary>
								<div class="directory-action-popover">
									<button type="button" data-open-form>Nuevo lugar</button>
									<button type="button" id="toolbar-import-url">Importar desde URLs</button>
									<button type="button" data-open-excel-import>Importar desde Excel</button>
								</div>
							</details>
						</div>
						<div class="directory-actions-grid">
							<details class="directory-action-menu view-action-menu">
								<summary><span><svg viewBox="0 0 24 24"><path d="M4 5h16v14H4zM9 5v14M4 10h5"/></svg>Ver</span><svg class="action-chevron" viewBox="0 0 24 24"><path d="m8 10 4 4 4-4"/></svg></summary>
								<div class="directory-action-popover view-options">
									<button type="button" data-directory-view="columns-5"><svg viewBox="0 0 24 24"><path d="M2 4h3v16H2zM6.5 4h3v16h-3zM11 4h3v16h-3zM15.5 4h3v16h-3zM20 4h2v16h-2z"/></svg>Iconos grandes</button>
									<button type="button" data-directory-view="columns-6"><svg viewBox="0 0 24 24"><path d="M2 4h2v16H2zM6 4h2v16H6zM10 4h2v16h-2zM14 4h2v16h-2zM18 4h2v16h-2zM22 4h1v16h-1z"/></svg>Iconos medianos</button>
									<button type="button" data-directory-view="small-icons"><svg viewBox="0 0 24 24"><path d="M3 3h4v4H3zM10 3h4v4h-4zM17 3h4v4h-4zM3 10h4v4H3zM10 10h4v4h-4zM17 10h4v4h-4zM3 17h4v4H3zM10 17h4v4h-4zM17 17h4v4h-4z"/></svg>Iconos pequeños</button>
									<button type="button" data-directory-view="detail"><svg viewBox="0 0 24 24"><path d="M4 5h4v4H4zM11 6h9M4 11h4v4H4zM11 12h9M4 17h4v4H4zM11 18h9"/></svg>Detalles</button>
									<button type="button" data-directory-view="list"><svg viewBox="0 0 24 24"><path d="M5 6h14M5 12h14M5 18h14"/></svg>Lista</button>
									<button type="button" data-directory-view="establishments"><svg viewBox="0 0 24 24"><path d="M4 20V8l8-4 8 4v12M8 20v-7h8v7M3 20h18"/></svg>Tipo de lugar</button>
									<button type="button" data-directory-view="cuisines"><svg viewBox="0 0 24 24"><path d="M4 5h10l6 6-9 9-7-7Z"/><circle cx="9" cy="10" r="1"/></svg>Tipos de cocina</button>
								</div>
							</details>
							<details class="directory-action-menu"><summary><span><svg viewBox="0 0 24 24"><path d="M8 4v16m0 0-3-3m3 3 3-3M16 20V4m0 0-3 3m3-3 3 3"/></svg>Ordenar</span><svg class="action-chevron" viewBox="0 0 24 24"><path d="m8 10 4 4 4-4"/></svg></summary><div class="directory-action-popover"><button type="button" data-directory-sort="recent">Más recientes</button><button type="button" data-directory-sort="oldest">Más antiguos</button><button type="button" data-directory-sort="name-asc">Nombre: A–Z</button><button type="button" data-directory-sort="name-desc">Nombre: Z–A</button></div></details>
							<details class="directory-action-menu filter-action-menu">
								<summary><span><svg viewBox="0 0 24 24"><path d="M4 5h16l-6 7v6l-4 2v-8Z"/></svg>Filtrar</span><svg class="action-chevron" viewBox="0 0 24 24"><path d="m8 10 4 4 4-4"/></svg></summary>
							</details>
						</div>
					</section>
					<section id="print-places-panel" class="print-places-panel" aria-label="Imprimir lugares" hidden>
						<div class="print-panel-heading">
							<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 9V4h10v5M7 17H5a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-2M7 14h10v7H7z"/></svg>
							<div><strong>Imprimir lugares</strong><span>Seleccioná los lugares</span></div>
						</div>
						<div class="print-panel-actions">
							<button id="select-visible-places" type="button">✓ <span>Seleccionar lugares visibles</span></button>
							<button id="select-all-places" type="button">☷ <span>Seleccionar todos</span></button>
							<button id="clear-print-selection" type="button">× <span>Quitar selección</span></button>
							<button type="button" data-print-mode="places">▣ <span>Imprimir lugares</span></button>
							<button type="button" data-print-mode="cards">▦ <span>Imprimir tarjetas</span></button>
							<button type="button" data-print-mode="list">☷ <span>Imprimir lista</span></button>
						</div>
						<button id="close-print-panel" class="close-print-panel" type="button" aria-label="Cerrar impresión" title="Cerrar">×</button>
					</section>
					<section id="edit-places-panel" class="print-places-panel" aria-label="Editar lugares" hidden>
						<div class="print-panel-heading">
							<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 5 5 5M4 20l4.5-1 10-10a2.1 2.1 0 0 0-3-3l-10 10z"/></svg>
							<div><strong>Editar lugares</strong><span>Seleccioná uno o varios lugares · Shift para un rango</span></div>
						</div>
						<div class="print-panel-actions edit-selection-actions">
							<button id="edit-select-visible" type="button">✓ <span>Seleccionar lugares visibles</span></button>
							<button id="edit-select-all" type="button">☷ <span>Seleccionar todos</span></button>
							<button id="edit-clear-selection" type="button">× <span>Quitar selección</span></button>
							<button id="edit-selected-places" type="button" disabled>✎ <span>Editar seleccionados</span></button>
						</div>
						<button id="close-edit-panel" class="close-print-panel" type="button" aria-label="Cerrar edición" title="Cerrar">×</button>
					</section>
					<section id="delete-places-panel" class="print-places-panel" aria-label="Eliminar lugares" hidden>
						<div class="print-panel-heading">
							<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M9 7V4h6v3m3 0-1 13H7L6 7m4 4v5m4-5v5"/></svg>
							<div><strong>Eliminar lugares</strong><span>Seleccioná uno o varios lugares · Shift para un rango</span></div>
						</div>
						<div class="print-panel-actions edit-selection-actions">
							<button id="delete-select-visible" type="button">✓ <span>Seleccionar lugares visibles</span></button>
							<button id="delete-select-all" type="button">☷ <span>Seleccionar todos</span></button>
							<button id="delete-clear-selection" type="button">× <span>Quitar selección</span></button>
							<button id="delete-selected-places" type="button" disabled>⌫ <span>Eliminar seleccionados</span></button>
						</div>
						<button id="close-delete-panel" class="close-print-panel" type="button" aria-label="Cerrar eliminación" title="Cerrar">×</button>
					</section>
					<section id="directory-filter-panel" class="directory-filter-panel" aria-label="Filtros del directorio" hidden>
						<div class="directory-filter-fields">
							<div class="filter-control"><span>Tipo de lugar</span><details class="filter-multiselect"><summary><span id="establishment-filter-label">Todos los lugares</span><svg viewBox="0 0 24 24"><path d="m8 10 4 4 4-4"/></svg></summary><div id="establishment-filter-options" class="filter-checkbox-list"></div></details><div id="establishment-filter-chips" class="filter-chips"></div></div>
							<div class="filter-control"><span>Servicio</span><details class="filter-multiselect"><summary><span id="meal-filter-label">Todos los servicios</span><svg viewBox="0 0 24 24"><path d="m8 10 4 4 4-4"/></svg></summary><div id="meal-filter-options" class="filter-checkbox-list"></div></details><div id="meal-filter-chips" class="filter-chips"></div></div>
							<div class="filter-control"><span>Tipo de cocina</span><details class="filter-multiselect"><summary><span id="cuisine-filter-label">Todos los tipos de cocina</span><svg viewBox="0 0 24 24"><path d="m8 10 4 4 4-4"/></svg></summary><div id="cuisine-filter-options" class="filter-checkbox-list"></div></details><div id="cuisine-filter-chips" class="filter-chips"></div></div>
							<div class="filter-control"><span>Barrio</span><details class="filter-multiselect"><summary><span id="neighborhood-filter-label">Todos los barrios</span><svg viewBox="0 0 24 24"><path d="m8 10 4 4 4-4"/></svg></summary><div id="neighborhood-filter-options" class="filter-checkbox-list"></div></details><div id="neighborhood-filter-chips" class="filter-chips"></div></div>
							<div class="filter-control"><span>Ciudad</span><details class="filter-multiselect"><summary><span id="city-filter-label">Todas las ciudades</span><svg viewBox="0 0 24 24"><path d="m8 10 4 4 4-4"/></svg></summary><div id="city-filter-options" class="filter-checkbox-list"></div></details><div id="city-filter-chips" class="filter-chips"></div></div>
							<div class="filter-status-buttons" aria-label="Filtros rápidos">
								<button id="favorite-filter" type="button" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 4.6a5.4 5.4 0 0 0-7.6 0L12 5.8l-1.2-1.2a5.4 5.4 0 0 0-7.6 7.6L12 21l8.8-8.8a5.4 5.4 0 0 0 0-7.6Z"/></svg>Favoritos</button>
								<button id="visited-filter" type="button" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4.5 4.5L19 7"/></svg>Visitados</button>
								<button id="clear-directory-filters" class="clear-directory-filters" type="button">Limpiar filtros</button>
							</div>
						</div>
					</section>

					<section class="directory-panel">
						<div class="panel-heading">
							<p id="result-description">Tus restaurantes registrados</p>
						</div>

						<div id="restaurant-list" class="restaurant-list" aria-live="polite"></div>
						<div id="empty-state" class="empty-state" hidden>
							<div class="empty-icon"><svg viewBox="0 0 32 32"><path d="M7 7h18v18H7zM11 12h10M11 17h7"/></svg></div>
							<h3 id="empty-title">Tu directorio está vacío</h3>
							<p id="empty-copy">Agregá tu primer restaurante para empezar a organizar la información.</p>
							<button class="secondary-button" type="button" data-open-form>Agregar restaurante</button>
						</div>
					</section>
				</div>
			</main>
		</div>

		<dialog id="restaurant-dialog">
			<form id="restaurant-form" method="dialog">
				<div class="dialog-heading">
					<div class="dialog-title-main">
						<h2 id="dialog-title">Nuevo lugar</h2>
						<button id="view-edit-button" class="header-edit-button" type="button" hidden>Editar lugar</button>
					</div>
					<div class="dialog-heading-right">
						<span id="dialog-record-name" hidden></span>
						<div id="restaurant-record-navigation" class="record-navigation" aria-label="Recorrer lugares" hidden>
							<button id="previous-restaurant" type="button" aria-label="Lugar anterior" title="Lugar anterior"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg></button>
							<button id="next-restaurant" type="button" aria-label="Lugar siguiente" title="Lugar siguiente"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg></button>
						</div>
						<button class="icon-button" type="button" data-close-form aria-label="Cerrar">×</button>
					</div>
				</div>
				<input type="hidden" name="id" />
				<div class="form-tabs" role="tablist" aria-label="Secciones de la ficha">
					<button class="form-tab active" id="tab-general" type="button" role="tab" aria-selected="true" aria-controls="panel-general" data-form-tab="general">1. Datos del lugar</button>
					<button class="form-tab" id="tab-details" type="button" role="tab" aria-selected="false" aria-controls="panel-details" data-form-tab="details">2. Características</button>
					<button class="form-tab" id="tab-links" type="button" role="tab" aria-selected="false" aria-controls="panel-links" data-form-tab="links">3. Links</button>
					<button class="form-tab" id="tab-information" type="button" role="tab" aria-selected="false" aria-controls="panel-information" data-form-tab="information">4. Información general</button>
					<button class="form-tab" id="tab-images" type="button" role="tab" aria-selected="false" aria-controls="panel-images" data-form-tab="images">5. Imágenes</button>
				</div>

				<section class="tab-panel" id="panel-general" role="tabpanel" aria-labelledby="tab-general" data-tab-panel="general">
					<div class="form-grid">
						<div class="establishment-lead wide">
							<div class="primary-image-column">
