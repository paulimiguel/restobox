---
import '../styles/global.css';
import { getUserProfile } from '../lib/server/auth';
const sessionUser = await Astro.session?.get('user');
const currentUser = sessionUser ? (getUserProfile(sessionUser.id) ?? sessionUser) : undefined;
const userDisplayName = currentUser?.alias || currentUser?.name || currentUser?.username || 'Usuario';
const userDisplayEmail = currentUser?.email || (currentUser?.username.includes('@') ? currentUser.username : '');
const userInitials = userDisplayName
	.split(/[\s._-]+/)
	.filter(Boolean)
	.slice(0, 2)
	.map((part) => part[0]?.toLocaleUpperCase('es'))
	.join('') || 'RB';
const sections = [
	{ id: 'favorites', title: 'Mis lugares favoritos', empty: 'Todavía no marcaste lugares como favoritos.' },
	{ id: 'visited', title: 'Mis lugares visitados', empty: 'Todavía no marcaste lugares como visitados.' },
	{ id: 'to-visit', title: 'Mis lugares a visitar', empty: 'Todavía no marcaste lugares como “A visitar”.' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
		<meta name="theme-color" content="#f90344" />
		<title>RestoBox · Mi perfil</title>
		<script is:inline>
			try {
				const colorMode = localStorage.getItem('restobox-color-mode') === 'dark' ? 'dark' : 'light';
				document.documentElement.dataset.colorMode = colorMode;
				document.documentElement.style.colorScheme = colorMode;
				document.documentElement.dataset.theme = localStorage.getItem('theme') || 'carrot';
				document.documentElement.dataset.fontTheme = localStorage.getItem('font-theme') || 'original';
			} catch {
				document.documentElement.dataset.colorMode = 'light';
			}
		</script>
	</head>
	<body>
		<div class="app-shell">
			<main>
				<header class="topbar">
					<a class="header-brand" href="/" aria-label="RestoBox, inicio"><img id="profile-page-logo" src="/restobox-logo-transparent.png" alt="RestoBox" /></a>
					<nav class="top-actions" aria-label="Acciones del perfil">
						<a class="top-nav-button profile-page-edit" href="/?editar=perfil">EDITAR PERFIL</a>
					</nav>
				</header>
				<div class="content profile-page">
					<section class="profile-page-hero" aria-label="Mi perfil">
						<div class="profile-page-avatar">
							{currentUser?.profilePhoto ? <img src={currentUser.profilePhoto} alt="" /> : <span>{userInitials}</span>}
						</div>
						<div class="profile-page-identity">
							<h1>{userDisplayName}</h1>
							{userDisplayEmail && <p>{userDisplayEmail}</p>}
						</div>
						<nav class="profile-page-jump" aria-label="Ir a una sección">
							{sections.map((section) => <a href={`#${section.id}`}>{section.title.replace('Mis lugares ', '').replace(/^./, (letter) => letter.toLocaleUpperCase('es'))}<span id={`count-${section.id}`}>0</span></a>)}
						</nav>
					</section>
					<section class="directory-actions profile-toolbar" aria-label="Buscar y filtrar mis lugares">
						<div class="directory-toolbar-main">
							<div class="action-search-group">
								<div class="directory-search-row">
									<label class="action-search">
										<span class="sr-only">Buscar lugares</span>
										<svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="6"/><path d="m16 16 4 4"/></svg>
										<input id="search" type="search" placeholder="Buscar" autocomplete="off" />
										<button id="paste-search" class="search-inline-action" type="button">Pegar</button>
										<button id="clear-search" class="search-inline-clear" type="button" aria-label="Borrar búsqueda" title="Borrar búsqueda" hidden>×</button>
									</label>
									<div class="quick-place-filters" role="radiogroup" aria-label="Tipo de lugar">
										<button class="quick-place-filter active" type="button" role="radio" aria-checked="true" data-place-type="all"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="6" height="6" rx="1"/><rect x="14" y="4" width="6" height="6" rx="1"/><rect x="4" y="14" width="6" height="6" rx="1"/><rect x="14" y="14" width="6" height="6" rx="1"/></svg>Todos</button>
										<button class="quick-place-filter" type="button" role="radio" aria-checked="false" data-place-type="restaurant"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V8l8-4 8 4v12M8 20v-7h8v7M3 20h18"/></svg>Restaurantes</button>
										<button class="quick-place-filter" type="button" role="radio" aria-checked="false" data-place-type="cafe"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8h11v6a5 5 0 0 1-5 5h-1a5 5 0 0 1-5-5V8Zm11 2h2a3 3 0 0 1 0 6h-2M4 21h14"/></svg>Cafes</button>
									</div>
								</div>
								<div class="directory-toolbar-lower-row">
									<div class="search-scope-options" role="radiogroup" aria-label="Campo de búsqueda">
										<button class="search-scope-option active" type="button" role="radio" aria-checked="true" data-search-scope="name">Nombre</button>
										<button class="search-scope-option" type="button" role="radio" aria-checked="false" data-search-scope="category">Categoria</button>
										<button class="search-scope-option" type="button" role="radio" aria-checked="false" data-search-scope="zone">Zona</button>
									</div>
									<div class="directory-actions-grid">
										<details class="directory-action-menu view-action-menu">
											<summary><span><svg id="directory-view-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h4v4H4zM11 6h9M4 11h4v4H4zM11 12h9M4 17h4v4H4zM11 18h9"/></svg>Ver</span><svg class="action-chevron" viewBox="0 0 24 24"><path d="m8 10 4 4 4-4"/></svg></summary>
											<div class="directory-action-popover view-options">
												<button type="button" data-directory-view="columns-5"><svg viewBox="0 0 24 24"><path d="M4 4h16v16H4z"/></svg>Iconos grandes</button>
												<button type="button" data-directory-view="columns-6"><svg viewBox="0 0 24 24"><path d="M3 3h8v8H3zM13 3h8v8h-8zM3 13h8v8H3zM13 13h8v8h-8z"/></svg>Iconos medianos</button>
												<button type="button" data-directory-view="small-icons"><svg viewBox="0 0 24 24"><path d="M3 3h4v4H3zM10 3h4v4h-4zM17 3h4v4h-4zM3 10h4v4H3zM10 10h4v4h-4zM17 10h4v4h-4zM3 17h4v4H3zM10 17h4v4h-4zM17 17h4v4h-4z"/></svg>Iconos pequeños</button>
												<button type="button" data-directory-view="detail"><svg viewBox="0 0 24 24"><path d="M4 5h4v4H4zM11 6h9M4 11h4v4H4zM11 12h9M4 17h4v4H4zM11 18h9"/></svg>Detalles</button>
												<button type="button" data-directory-view="list"><svg viewBox="0 0 24 24"><path d="M5 6h14M5 12h14M5 18h14"/></svg>Lista</button>
											</div>
										</details>
										<details class="directory-action-menu"><summary><span><svg viewBox="0 0 24 24"><path d="M8 4v16m0 0-3-3m3 3 3-3M16 20V4m0 0-3 3m3-3 3 3"/></svg>Ordenar</span><svg class="action-chevron" viewBox="0 0 24 24"><path d="m8 10 4 4 4-4"/></svg></summary><div class="directory-action-popover sort-options"><button type="button" data-directory-sort-key="date"><span>Fecha</span><svg class="sort-direction-icon" viewBox="0 0 24 24" aria-hidden="true"><path class="sort-arrow-up" d="m8 9 4-4 4 4M12 5v14"/><path class="sort-arrow-down" d="m8 15 4 4 4-4"/></svg></button><button type="button" data-directory-sort-key="name"><span>Nombre</span><svg class="sort-direction-icon" viewBox="0 0 24 24" aria-hidden="true"><path class="sort-arrow-up" d="m8 9 4-4 4 4M12 5v14"/><path class="sort-arrow-down" d="m8 15 4 4 4-4"/></svg></button><button type="button" data-directory-sort-key="zone"><span>Zona</span><svg class="sort-direction-icon" viewBox="0 0 24 24" aria-hidden="true"><path class="sort-arrow-up" d="m8 9 4-4 4 4M12 5v14"/><path class="sort-arrow-down" d="m8 15 4 4 4-4"/></svg></button></div></details>
										<details class="directory-action-menu filter-action-menu">
											<summary><span><svg viewBox="0 0 24 24"><path d="M4 5h16l-6 7v6l-4 2v-8Z"/></svg>Filtrar</span><svg class="action-chevron" viewBox="0 0 24 24"><path d="m8 10 4 4 4-4"/></svg></summary>
										</details>
									</div>
								</div>
							</div>
						</div>
					</section>
					<section id="directory-filter-panel" class="directory-filter-panel profile-filter-panel" aria-label="Filtros" hidden>
						<div class="directory-filter-fields">
							<div class="filter-control"><span>Categorías</span><details class="filter-multiselect"><summary><span id="establishment-filter-label">Todas las categorías</span><svg viewBox="0 0 24 24"><path d="m8 10 4 4 4-4"/></svg></summary><div id="establishment-filter-options" class="filter-checkbox-list"></div></details></div>
							<div class="filter-control"><span>Servicios</span><details class="filter-multiselect"><summary><span id="meal-filter-label">Todos los servicios</span><svg viewBox="0 0 24 24"><path d="m8 10 4 4 4-4"/></svg></summary><div id="meal-filter-options" class="filter-checkbox-list"></div></details></div>
							<div class="filter-control"><span>Tipo de cocina</span><details class="filter-multiselect"><summary><span id="cuisine-filter-label">Todos los tipos de cocina</span><svg viewBox="0 0 24 24"><path d="m8 10 4 4 4-4"/></svg></summary><div id="cuisine-filter-options" class="filter-checkbox-list"></div></details></div>
							<div class="filter-control"><span>Ciudad</span><details class="filter-multiselect"><summary><span id="city-filter-label">Todas las ciudades</span><svg viewBox="0 0 24 24"><path d="m8 10 4 4 4-4"/></svg></summary><div id="city-filter-options" class="filter-checkbox-list"></div></details></div>
							<div class="filter-control"><span>Zona</span><details class="filter-multiselect"><summary><span id="neighborhood-filter-label">Todas las zonas</span><svg viewBox="0 0 24 24"><path d="m8 10 4 4 4-4"/></svg></summary><div id="neighborhood-filter-options" class="filter-checkbox-list"></div></details></div>
							<div class="filter-status-buttons" aria-label="Filtros rápidos">
								<button id="gluten-free-filter" type="button" aria-pressed="false">Sin gluten</button>
								<button id="delivery-filter" type="button" aria-pressed="false">Delivery</button>
								<button id="take-away-filter" type="button" aria-pressed="false">Take away</button>
								<button id="clear-directory-filters" class="clear-directory-filters" type="button">Quitar filtros</button>
							</div>
						</div>
					</section>
					{sections.map((section) => (
						<section class="my-places-section" id={section.id} aria-labelledby={`title-${section.id}`}>
							<header>
								<h2 id={`title-${section.id}`}>{section.title}</h2>
							</header>
							<div class="my-places-grid view-detail" id={`list-${section.id}`} data-empty={section.empty}>
								<p class="my-places-empty">Cargando…</p>
							</div>
						</section>
					))}
				</div>
			</main>
		</div>
		<nav class="app-tabbar" aria-label="Navegación principal">
			<a href="/"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z"/></svg><span>Directorio</span></a>
			<a href="/?vista=establishment"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V8l8-4 8 4v12M8 20v-7h8v7M3 20h18"/></svg><span>Categorías</span></a>
			<a href="/?vista=cuisine"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3v8M5 3v5a2 2 0 0 0 4 0V3M7 11v10M17 3c-2 2-3 5-3 8h3v10"/></svg><span>Tipo de cocina</span></a>
			<a class="active" href="/perfil" aria-current="page"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M5 20a7 7 0 0 1 14 0"/></svg><span>Mi perfil</span></a>
		</nav>
		<script src="../scripts/perfil.ts"></script>
	</body>
</html>
